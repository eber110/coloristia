Options -MultiViews
RewriteEngine On

# NO interceptar peticiones a /api/ - dejar que pasen al proxy de Node.js
RewriteRule ^api/ - [L]

# Si el archivo o directorio existe físicamente, servirlo directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demás al index.html para React Router
RewriteRule ^ index.html [QSA,L]
