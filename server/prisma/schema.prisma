generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      String    @default("REGISTERED")
  palettes  Palette[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Palette {
  id        Int      @id @default(autoincrement())
  name      String
  colors    String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
